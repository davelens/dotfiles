#!/usr/bin/env bash
set -e
set +x
# Resolve direct and installed symlink entries without inherited checkout exports.
_dots_entry=${BASH_SOURCE[0]}
[[ $_dots_entry == */* ]] || _dots_entry="./$_dots_entry"
_dots_count=0
while [[ -L $_dots_entry ]]; do
  _dots_directory=$(cd -P -- "${_dots_entry%/*}" && pwd) || exit 1
  _dots_entry=$(readlink -- "$_dots_entry") || exit 1
  [[ $_dots_entry == /* ]] || _dots_entry="$_dots_directory/$_dots_entry"
  ((_dots_count+=1))
  ((_dots_count <= 40)) || exit 1
done
_dots_directory=$(cd -P -- "${_dots_entry%/*}" && pwd) || exit 1
source "$_dots_directory/../setup/common.sh"
dots_bootstrap readiness "$_dots_directory/utility"
source "$DOTS_SOURCE_ROOT/bash/helpers.sh"
source "$DOTS_SOURCE_ROOT/bash/env/misc.sh"
export BASH_ENV="$DOTS_SOURCE_ROOT/bash/helpers.sh"
source "$DOTS_SOURCE_ROOT/bash/utility-context.sh"

if [[ $# == 0 || ${1:-} == --help || ${1:-} == -h ]]; then
  printf 'Usage: utility <category> <command> [ARG ...]\nAvailable commands:\n'
  utility_list
  exit 0
fi
category=$1
if [[ $# == 1 || ${2:-} == --help || ${2:-} == -h ]]; then
  utility_category_allowed "$category" || fail "utility: Category '$category' is unavailable for platform/selection '$DOTS_OS/$DOTS_SELECTION'."
  utility_commands "$category"
  exit 0
fi
command=$2
utility_allowed "$category" "$command" || fail "utility: '$category $command' is unavailable for platform/selection '$DOTS_OS/$DOTS_SELECTION'."
script="$DOTS_SOURCE_ROOT/bin/utilities/$category/$command"
[[ -f $script && -x $script ]] || fail "utility: Missing executable '$category $command'; register the dotsys helper category or provide this custom utility before retrying."
utility_require "$category" "$command"
shift 2
exec "$script" "$@"
