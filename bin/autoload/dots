#!/usr/bin/env bash
# shellcheck disable=SC2154,SC1091
set -eo pipefail

set +x
unset BASH_ENV ENV

# Resolve the invoked checkout, including installed symlinks; ignore stale exports.
entry=${BASH_SOURCE[0]}
[[ $entry == */* ]] || entry="./$entry"
count=0
while [[ -L $entry ]]; do
  directory=$(cd -P -- "${entry%/*}" && pwd)
  entry=$(readlink -- "$entry")
  [[ $entry == /* ]] || entry="$directory/$entry"
  ((count+=1))
  ((count <= 40)) || exit 1
done
root=$(cd -P -- "${entry%/*}/../.." && pwd)

usage() {
  cat <<'EOF'
Usage: dots <command> [OPTIONS]
  install      Configuration only, on a prepared machine (setup/install).
               --check, --select CSV, --wezterm-destination PATH, --save,
               --adopt PATH, --replace PATH. All arguments pass through.
  check        prerequisites | readiness [--select CSV] [--wezterm-destination PATH]
  setup        Delegate to an existing dotsys checkout; no implicit clone.
               --arch | --void | --dotsys arch|void|macos|wsl: staged provisioning.
               --dotvim / --dotshell: acquire/register requested tools only.
               --dotfiles: configuration only; --full-machine: explicit extras.
               HOME/user/XDG, checkout paths and approvals pass through to dotsys.
               Set DOTSYS_REPO_HOME to an absolute stable checkout (default: sibling dotsys).
  logs         Open the log in $EDITOR.
  update       Legacy bulk update; checked updates are not implemented yet.
  -h, --help   Show help.
Choices are transient unless install --save is explicit. Adoption enrolls matching
artifacts; replacement needs a successful backup. Neither install nor check provisions.
EOF
}

logs() {
  if [ ! -s "$log_file" ]; then
    fail "$($print_status -i error "The log file is currently empty.")"
  fi

  if [[ "$EDITOR" == *vim* ]]; then
    winbar='Press "q" to stop reading or "c" to clear the logs'

    $EDITOR \
      -c 'set nomodifiable laststatus=0' \
      -c 'highlight WinBarMsg guifg=#ffcc00 guibg=#44475a gui=bold' \
      -c "lua vim.o.winbar = '%#WinBarMsg#$winbar'" \
      -c 'nnoremap q :q<CR>' \
      -c "nnoremap c :silent !truncate -s 0 '$log_file' \| edit<CR>" \
      -R + "$log_file"
  else
    $EDITOR "$log_file"
  fi
}

install() {
  exec bash "$root/setup/install" "$@"
}

update_dotbot() {
  $print_status -nc "Updating dotbot to latest master ..."

  local dotbot_path="$DOTFILES_REPO_HOME/dotbot"

  if git -C "$dotbot_path" fetch origin >/dev/null 2>&1 &&
    git -C "$dotbot_path" checkout origin/master >/dev/null 2>&1; then
    if git -C "$DOTFILES_REPO_HOME" diff --quiet dotbot; then
      $print_status -i ok "dotbot already up to date"
    else
      git -C "$DOTFILES_REPO_HOME" add dotbot
      git -C "$DOTFILES_REPO_HOME" commit -m "Update dotbot submodule to latest master" &>>"$log_file"
      $print_status -i ok "dotbot updated and committed"
    fi
  else
    $print_status -i error "Failed to update dotbot"
    return 1
  fi
}

update_repo() {
  local repo_path="$1"
  local repo_name
  repo_name=$(basename "$repo_path")

  $print_status -nc "Updating $repo_name ..."

  # Check for uncommitted changes (unstaged and staged)
  if ! git -C "$repo_path" diff-files --quiet 2>/dev/null ||
    ! git -C "$repo_path" diff-index --cached --quiet HEAD 2>/dev/null; then
    $print_status -i error "$repo_name has uncommitted changes, skipping"
    return 1
  fi

  if ! git -C "$repo_path" pull --rebase &>>"$log_file"; then
    $print_status -i error "Failed to update $repo_name"
    return 1
  fi

  $print_status -i ok "$repo_name updated"
}

setup() {
  local delegate_root=${DOTSYS_REPO_HOME:-${root%/*}/dotsys}
  [[ $delegate_root == /* && -f $delegate_root/shared/install.sh ]] || {
    printf 'dots: Missing dotsys shared/install.sh; obtain a stable dotsys checkout and set DOTSYS_REPO_HOME to its absolute path. No provisioning was run.\n' >&2
    return 1
  }
  exec bash "$delegate_root/shared/install.sh" setup --dotfiles-root "$root" "$@"
}

update() {
  update_dotbot

  # Update all locally installed dot-repos
  local dotfiles_updated=0
  for repo_path in "$REPO_NAMESPACE"/davelens/dot*; do
    [[ -d "$repo_path/.git" ]] || continue

    if update_repo "$repo_path"; then
      [[ "$repo_path" == "$DOTFILES_REPO_HOME" ]] && dotfiles_updated=1
    fi
  done

  # Run the dotfiles installer after all repos are updated
  if [[ $dotfiles_updated -eq 1 ]]; then
    $print_status -nc "Running dotfiles installer ..."
    if "$DOTFILES_REPO_HOME/setup/install" &>>"$log_file"; then
      $print_status -i ok "dotfiles installer complete"
    else
      $print_status -i error "dotfiles installer failed"
    fi
  fi

  echo
  echo "Logs available at $log_file"
}

###############################################################################

main() {
  case "${1:---help}" in
    -h|--help) usage ;;
    install) shift; install "$@" ;;
    check) shift; exec bash "$root/setup/check" "$@" ;;
    setup) shift; setup "$@" ;;
    logs|update)
      # Legacy operations only; install/check/setup do not initialize a shell or log.
      source "$root/setup/common.sh"
      dots_bootstrap readiness "$root/setup/install"
      source "$root/bash/helpers.sh"
      log_file="$DOTFILES_STATE_HOME/dots.log"
      mkdir -p "$DOTFILES_STATE_HOME"
      touch "$log_file"
      "$1" ;;
    *) printf 'dots: Unknown command: %s\n' "$1" >&2; usage >&2; return 2 ;;
  esac
}

main "$@"
