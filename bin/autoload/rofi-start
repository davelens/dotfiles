#!/usr/bin/env bash

# Launch rofi with one of the themes in $XDG_CONFIG_HOME/rofi, or close it if
# it's already open (so a keybind toggles it).
#
#   rofi-start [--mode drun|run|window|...] [rofi args...]
#   rofi-start --dmenu [--theme launcher|dmenu|applet] [rofi args...]

set -e

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_BIN_HOME="${XDG_BIN_HOME:-$HOME/.local/bin}"

mode="drun"
dmenu=0
theme=""
extra_args=() # Any additional arguments to pass through to rofi

main() {
  if pgrep -x rofi >/dev/null; then
    pkill -x rofi
    exit 0
  fi

  while [[ $# -gt 0 ]]; do
    case $1 in
    --dmenu | -dmenu)
      dmenu=1
      shift
      ;;
    --theme)
      theme="$2"
      shift 2
      ;;
    --mode)
      mode="$2"
      shift 2
      ;;
    *)
      extra_args+=("$1")
      shift
      ;;
    esac
  done

  if [ $dmenu -eq 1 ]; then
    cmd=(rofi -dmenu)
    theme="${theme:-dmenu}"
  else
    cmd=(rofi -show "$mode" -run-command "$XDG_BIN_HOME/desktop-session launch {cmd}")
    theme="${theme:-launcher}"
  fi

  "${cmd[@]}" -theme "$XDG_CONFIG_HOME/rofi/$theme.rasi" "${extra_args[@]}"
}

main "$@"
