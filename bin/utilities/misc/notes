#!/usr/bin/env bash
set -e

# Open a tmux session in the NAS notes directory.
LOCATION=100.73.75.7
platform=$(os --platform)
distro=$(os)

mountpoint="$HOME/Network/alexandria"
mkdir -p "$mountpoint"

if ! mount | grep -Fq " on $mountpoint "; then
  case "$platform:$distro" in
    macos:*)
      mount_smbfs "//davelens@${LOCATION}/storage/projects/notes" "$mountpoint"
      ;;
    linux:wsl)
      sudo mount -t drvfs "\\\\${LOCATION}\\storage\\projects\\notes" "$mountpoint"
      ;;
    linux:*)
      # This NAS supports SMB 2.0, below the client's default minimum of 2.1.
      sudo mount -t cifs "//${LOCATION}/storage" "$mountpoint" \
        -o "vers=2.0,username=davelens,prefixpath=projects/notes,uid=$(id -u),gid=$(id -g)"
      ;;
    *)
      echo "notes: unsupported platform: $platform" >&2
      exit 1
      ;;
  esac
fi

utility tmux quickstart "$@" -- "$mountpoint" --
