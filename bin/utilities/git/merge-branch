#!/usr/bin/env bash

# Beware that this will clean up remaining local and remote branches 
# post-merge if you choose to push the target branch.

# Stops further execution after any error.
set -e

branch_name=$(git b) # `git b` is an alias in my ~/.gitconfig
if [[ -z $branch_name ]]; then
  echo "ERROR: No command 'git b' found."
  echo "Grab it here: https://github.com/davelens/dotfiles/blob/master/gitconfig#L8"
  exit
fi

if [[ $# -eq 0 ]]; then
  read -p "To which branch would you like to merge $branch_name? (default: develop) " target
  [[ -z $target ]] && target="develop"
else
  target="$1"
fi

git checkout $target
git merge --no-ff $branch_name

# Prints the number of the open Forgejo PR for $branch_name -> $target, if any.
# Fails silently on non-Forgejo remotes.
forgejo_pr_number() {
  command -v fj >/dev/null || return 0
  local n
  for n in $(fj --style minimal pr search 2>/dev/null | sed -n 's/^#\([0-9]*\):.*/\1/p'); do
    if fj --style minimal pr view "$n" 2>/dev/null | grep -qF "From \`$branch_name\` into \`$target\`"; then
      echo "$n"
      return
    fi
  done
}

# Forgejo flags PRs as merged asynchronously after a push; deleting the head
# branch before that happens closes the PR instead.
wait_for_merged_pr() {
  for _ in {1..30}; do
    fj --style minimal pr view "$1" 2>/dev/null | sed -n 2p | grep -q " Merged " && return
    sleep 1
  done
  return 1
}

push_and_clean_up() {
  local pr
  pr=$(forgejo_pr_number)
  git push origin $target
  echo "Branch $target pushed to remote."
  git branch -d $branch_name
  echo "Local branch $branch_name removed."
  if [[ -n $pr ]]; then
    echo "Waiting for Forgejo to mark PR #$pr as merged..."
    if ! wait_for_merged_pr "$pr"; then
      echo "PR #$pr not marked as merged after 30s; keeping remote branch $branch_name."
      return
    fi
  fi
  git push origin :$branch_name
  echo "Remote branch $branch_name removed."

  # Cleaning up files made by `git pr-body`.
  rm -f "$(git rev-parse --absolute-git-dir)/$branch_name.md"
}

while true; do
  read -n1 -p "Do you want to push to the remote $target branch? " yn
  printf "\n"
  case $yn in
    [Yy]* ) push_and_clean_up; break;;
    [Nn]* ) exit;;
    * ) echo "Please answer $(tput smul)Y$(tput rmul)es or $(tput smul)N$(tput rmul)o.";;
  esac
done

echo "$branch_name merged into $target."
