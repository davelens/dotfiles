#!/usr/bin/env bash
set -e

# Homebrew provisioning lives in dotsys. This just saves me the path when I
# want to (re)install Homebrew or re-run the Brewfile bundles.
dotsys_init="$REPO_NAMESPACE/davelens/dotsys/shared/brew/init.sh"

[ -x "$dotsys_init" ] || fail "dotsys is not installed. Run \`dots setup --dotsys <os>\` first."

"$dotsys_init" "$@"
