#!/usr/bin/env bash
set +x
unset BASH_ENV ENV

# Resolve an installed entry-point symlink before loading checkout code.
entry=${BASH_SOURCE[0]}
[[ $entry == */* ]] || entry="./$entry"
count=0
while [[ -L $entry ]]; do
  directory=$(cd -P -- "${entry%/*}" && pwd) || exit 1
  entry=$(readlink -- "$entry") || exit 1
  [[ $entry == /* ]] || entry="$directory/$entry"
  ((count+=1))
  ((count <= 40)) || exit 1
done
directory=$(cd -P -- "${entry%/*}" && pwd) || exit 1
source "$directory/common.sh" || exit 1

case ${1:-} in
  prerequisites|readiness|candidate) mode=$1; shift ;;
  *)
    printf '%s\n' 'Usage: setup/check prerequisites|readiness [--select LIST] [--wezterm-destination PATH]' \
      '       setup/check candidate --install-root PATH [choices] (not yet implemented)' >&2
    exit 2 ;;
esac
dots_bootstrap "$mode" "$directory/check" "$@" || exit 1
if [[ $mode == candidate ]]; then
  dots_error 'Candidate artifact/ownership validation is not implemented; no candidate acceptance is available.'
  exit 2
fi
source "$DOTS_SOURCE_ROOT/setup/requirements.sh" || exit 1
"dots_$mode" || exit 1
printf 'dots: %s passed (installed capabilities, not live-session validation).\n' "$mode"
