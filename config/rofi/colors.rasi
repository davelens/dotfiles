/* Catppuccin palette (from adi1090x/rofi), shared by every theme. */

* {
    font:           "Hack Nerd Font Mono 12";
    background:     #1E1D2FFF;
    background-alt: #282839FF;
    foreground:     #D9E0EEFF;
    selected:       #B4BEFEFF;
    border:         #B4BEFEFF;
    active:         #ABE9B3FF;
    urgent:         #F28FADFF;
}
