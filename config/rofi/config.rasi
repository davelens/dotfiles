/* Rofi 2.0 configuration. Look & feel lives in the *.rasi themes next to
   this file; rofi-start picks the theme. */

configuration {
  modi: "drun,run,filebrowser,window";
  show-icons: true;
  icon-theme: "Papirus";
  terminal: "rofi-sensible-terminal";
  matching: "normal";
  tokenize: true;
  normalize-match: true;
  cycle: true;
  steal-focus: false;
  click-to-exit: true;
  max-history-size: 25;

  drun-match-fields: "name,generic,exec,categories,keywords";
  drun-url-launcher: "xdg-open";
  drun {
    /* Disable D-Bus activation — on Sway (non-GNOME), it can race with the
       desktop-session launch path and create duplicate application windows. */
    DBusActivatable: false;
  }

  run,drun {
    fallback-icon: "application-x-addon";
  }

  window-match-fields: "title,class";

  filebrowser {
    directories-first: true;
    sorting-method: "name";
  }
}
