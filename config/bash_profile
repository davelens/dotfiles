#!/usr/bin/env bash
set +x
# Resolve direct and installed symlink entries without inherited checkout exports.
_dots_entry=${BASH_SOURCE[0]}
[[ $_dots_entry == */* ]] || _dots_entry="./$_dots_entry"
_dots_count=0
while [[ -L $_dots_entry ]]; do
  _dots_directory=$(cd -P -- "${_dots_entry%/*}" && pwd) || return 1
  _dots_entry=$(readlink -- "$_dots_entry") || return 1
  [[ $_dots_entry == /* ]] || _dots_entry="$_dots_directory/$_dots_entry"
  ((_dots_count+=1))
  ((_dots_count <= 40)) || return 1
done
_dots_directory=$(cd -P -- "${_dots_entry%/*}" && pwd) || return 1
source "$_dots_directory/../setup/common.sh" || return 1
_dots_initial_ps1=${PS1-}
dots_bootstrap readiness "$_dots_directory/bash_profile" || return 1
export BASH_ENV="$DOTS_SOURCE_ROOT/bash/helpers.sh"
source "$BASH_ENV"
source "$DOTS_SOURCE_ROOT/bash/env/misc.sh"
source "$DOTS_SOURCE_ROOT/bash/env/ruby.sh"
unset _dots_entry _dots_directory _dots_count

# Shell behaviour and tool activation are interactive, not installation effects.
if [[ $- == *i* ]]; then
  mapfile -t _dots_local_aliases < <(alias -p)
  source "$DOTS_SOURCE_ROOT/bash/colors.sh"
  source "$DOTS_SOURCE_ROOT/bash/aliases.sh"
  source "$DOTS_SOURCE_ROOT/bash/env/options.sh"
  source "$DOTS_SOURCE_ROOT/bash/env/history.sh"
  source "$DOTS_SOURCE_ROOT/bash/env/completion.sh"
  dots_optional_hook mise activate bash || :
  source "$DOTS_SOURCE_ROOT/bash/env/ssh.sh"
  case $DOTS_OS in
    arch|void|macos|wsl) source "$DOTS_SOURCE_ROOT/bash/env/os/$DOTS_OS/init.sh" ;;
  esac
  for _dots_alias in "${_dots_local_aliases[@]}"; do eval "$_dots_alias"; done
  unset _dots_alias _dots_local_aliases
  # A prompt explicitly supplied by trusted env remains authoritative.
  [[ ${PS1-} != "$_dots_initial_ps1" ]] || source "$DOTS_SOURCE_ROOT/bash/prompt.sh"
fi
unset _dots_initial_ps1
