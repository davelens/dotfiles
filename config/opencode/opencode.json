{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp",
      "options": {
        "baseURL": "http://framework-desktop:8080/v1"
      },
      "models": {
        "qwen3": {
          "id": "qwen",
          "name": "Qwen 3.6 35B UD Q4_K_M"
        }
      }
    },
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:3456",
        "apiKey": "dummy"
      }
    }
  },
  "model": "anthropic/claude-opus-5",
  "permission": {
    "external_directory": {
      "~/.config/**": "allow",
      "~/Repositories/**": "allow",
      "/tmp/**": "allow"
    }
  },
  "skills": {
    "paths": [
      "~/.config/agents/skills/opencode"
    ]
  },
  "plugin": [
    "opencode-with-claude@1.8.0"
  ]
}
