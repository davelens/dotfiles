{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp",
      "options": {
        "baseURL": "http://framework-desktop:8080/v1"
      },
      "models": {
        "gemma-4-31b-it-q8": {
          "name": "Gemma 4 31B IT (Q8_K_XL)",
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": {
            "context": 131072,
            "output": 65536
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "ornith-1.0-35b-q4": {
          "name": "Ornith 1.0 35B (Q4_K_M)",
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": {
            "context": 131072,
            "output": 65536
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "ornith-1.0-35b-q5": {
          "name": "Ornith 1.0 35B (Q5_K_M)",
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": {
            "context": 131072,
            "output": 65536
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "qwen3.6-27b-q6": {
          "name": "Qwen 3.6 27B (Q6_K_XL)",
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": {
            "context": 131072,
            "output": 65536
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "qwen3.6-35b-a3b-q4": {
          "name": "Qwen 3.6 35B A3B (Q4_K_M)",
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": {
            "context": 131072,
            "output": 65536
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "qwen3-coder-next-q8": {
          "name": "Qwen3 Coder Next (Q8_0)",
          "reasoning": false,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 65536
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    },
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:3456",
        "apiKey": "dummy"
      }
    }
  },
  "model": "anthropic/claude-opus-5",
  "permission": {
    "external_directory": {
      "~/.config/**": "allow",
      "~/Repositories/**": "allow",
      "/tmp/**": "allow"
    }
  },
  "skills": {
    "paths": [
      "~/.config/agents/skills/opencode"
    ]
  },
  "plugin": [
    "opencode-with-claude@1.8.0"
  ]
}
