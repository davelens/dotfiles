### Autostart #################################################################

xwayland enable

# Automatic H/V split tiling.
exec autotiling-rs

# Idle configuration
# 1. Lock screen after 300 seconds of inactivity.
# 2. Honor the login-session lock request used by the dotsys power helper.
# 3. Lock screen before the computer sleeps.
exec swayidle -w \
  timeout 300 'swaylock -f -c 000000' \
  lock 'swaylock -f -c 000000' \
  before-sleep 'swaylock -f -c 000000'

# Clipboard manager (supports text and images)
exec wl-clip-persist --clipboard regular
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
